{
  "name": "wasm-quickjs-dom-vitest-react-compare",
  "version": "1.0.0",
  "private": true,
  "description": "Compare compatibility and performance of Vitest + React tests across jsdom and wasm-quickjs-dom environments",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:jsdom": "vitest run --project jsdom",
    "test:wasm": "vitest run --project wasm-quickjs-dom",
    "probe": "vitest run --config vitest.probes.config.ts",
    "bench": "node scripts/bench.mjs",
    "bench:quick": "node scripts/bench.mjs --repeats 1",
    "compare": "node scripts/compare.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vitest": "^5.1.0",
    "vitest-environment-wasm-quickjs-dom": "^1.0.16",
    "wasm-quickjs-dom": "^1.0.16"
  }
}
